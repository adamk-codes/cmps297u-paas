# Copy to .env.local (git-ignored).

# Platform API base URL. Leave empty for the mock (local UI work).
#   local API:  http://localhost:8080   (docker compose --profile api up, in sample-apps/notes-app)
#   deployed:   empty + VITE_USE_MOCK=false  (dashboard and /api share the CloudFront origin)
VITE_API_URL=
# true = always mock, false = always HTTP. Unset: HTTP when VITE_API_URL is set.
VITE_USE_MOCK=

# Cognito user pool for team sign-in (terraform -chdir=infra/foundation output).
# Without VITE_COGNITO_CLIENT_ID, sign-in is mocked (any email + 8-character password).
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
