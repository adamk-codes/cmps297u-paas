# Rebound API settings. Local dev runs it via sample-apps/notes-app/docker-compose.yml (profile "api").
PORT=8080
CORS_ORIGINS=http://localhost:5173

# process = run jobs/backup-restore/*.sh here; kubernetes = run k8s/rebound-data.sh (EKS)
EXECUTOR=process
JOBS_DIR=

# Backups
S3_BUCKET=rebound-backups
S3_PREFIX=backups
S3_ENDPOINT=
AWS_REGION=us-east-1

# Operation history (platform database). Unset = in memory.
PLATFORM_DATABASE_URL=

# Team sign-in (from infra/ Terraform outputs). Unset = no auth (local only).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# process executor only
ADMIN_DATABASE_URL=
LOCAL_APPS={"notes-app":{"databaseUrl":"postgres://notes_app:pw@localhost:5432/notes_app","healthUrl":"http://localhost:3000/healthz"}}
RECOVERY_URL_TEMPLATE=http://localhost:3001/apps/{app}-recovery/
OPERATION_TIMEOUT_SECONDS=1500
