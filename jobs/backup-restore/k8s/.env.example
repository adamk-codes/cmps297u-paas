# Copy to k8s/.env (git-ignored) and fill in from `terraform output` in infra/.
NAMESPACE=apps
AWS_REGION=us-east-1

# ECR registry, e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REGISTRY=
# Jobs image (printed by `rebound-data.sh push-image`)
JOBS_IMAGE=
# App images are $ECR_REGISTRY/<app>:<tag> unless overridden (must match the pipeline's repo name)
APP_IMAGE_REPO=

# Backup bucket and KMS keys
S3_BUCKET=
S3_KMS_KEY_ID=
SECRETS_KMS_KEY_ID=

# IAM role for the rebound-data-jobs service account (IRSA), with k8s/iam-policy.json attached
DATA_JOBS_ROLE_ARN=

# RDS: endpoint host and the Secrets Manager secret holding the master username/password
RDS_HOST=
RDS_MASTER_SECRET_ID=

# Shared ALB: IngressGroup name used by every app's Ingress, and (optional) its URL
ALB_GROUP=rebound
ALB_URL=

BACKUP_SCHEDULE="0 2 * * *"
MIN_ROWS=100
